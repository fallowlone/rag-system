{
  "name": "rag-system",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "embeddings:backfill-local": "ts-node src/cli/backfill-local-embeddings.ts",
    "embeddings:backfill-local:prod": "node dist/cli/backfill-local-embeddings.js",
    "embeddings:verify-cutover:prod": "node dist/cli/verify-local-embedding-cutover.js",
    "eval:retrieval": "ts-node scripts/eval-golden-set.ts",
    "eval:extraction": "cargo test --manifest-path apps/macos/Cargo.toml -p dokumente-core --test extraction_recall -- --nocapture",
    "eval:extraction:model": "cargo run --manifest-path apps/macos/Cargo.toml -q -p dokumente-core --features llama --example eval-extraction --",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.109.1",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.5.10",
    "axios": "^1.7.0",
    "bullmq": "5.76.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "^16.4.0",
    "fast-xml-parser": "^4.5.0",
    "grammy": "^1.31.0",
    "helmet": "8.1.0",
    "ioredis": "5.10.1",
    "md5": "^2.3.0",
    "p-limit": "^3.1.0",
    "pdf-parse": "2.4.5",
    "piscina": "4.9.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "zod": "4.3.6"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/adm-zip": "^0.5.5",
    "@types/express": "5.0.6",
    "@types/ioredis": "4.28.10",
    "@types/jest": "30.0.0",
    "@types/md5": "^2.3.5",
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "1.1.5",
    "@typescript-eslint/eslint-plugin": "8.58.2",
    "@typescript-eslint/parser": "8.58.2",
    "eslint": "10.2.1",
    "jest": "30.3.0",
    "prisma": "^5.22.0",
    "ts-jest": "29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
