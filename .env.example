DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/lawrag?schema=public"
REDIS_PASSWORD="change-me"
REDIS_URL="redis://:change-me@127.0.0.1:6380"
LOCAL_RETRIEVAL_URL="http://127.0.0.1:8001"
LOCAL_RETRIEVAL_BATCH_SIZE=32
LOCAL_RETRIEVAL_TIMEOUT_MS="10000"
ANTHROPIC_API_KEY="sk-ant-..."
TELEGRAM_BOT_TOKEN="..."
# Public @username of the bot (without @) — the macOS app deep-links the bot
# chat for reverse pairing. Optional: when unset the app falls back to copy-paste.
TELEGRAM_BOT_USERNAME="your_bot_username"
# Your Telegram numeric user ID — used for owner-only notifications (deadlines, health alerts, /status dashboard)
# Find it by messaging @userinfobot on Telegram
OWNER_TELEGRAM_ID=""
# Docvault service auth — must match RAG_BOT_SECRET in docvault .env
RAG_BOT_SECRET=your-shared-secret-here

# ── Deployment note: TLS ───────────────────────────────────────────────────
# The macOS client authenticates with a device Bearer token on every /app/v1
# request. Nothing in this repository terminates TLS, and the app service is
# the only one published on all interfaces (docker-compose.yml), so a remote
# deployment MUST sit behind a reverse proxy with HTTPS. The client enforces
# its half: it refuses to send the token to a plain-http:// origin that is not
# loopback (see base_url_allows_token in dokumente-core).
