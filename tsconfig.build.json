{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    // Full emit on every build. Incremental + nest's deleteOutDir wiped
    // dist/ on no-change rebuilds (stale tsbuildinfo → zero emit, exit 0).
    "incremental": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "test", "dist", "prisma", "**/*spec.ts"]
}
