generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Law {
  id          String     @id // Abkürzung, e.g. "BGB", "AufenthG"
  title       String // full Gesetz title
  xmlUrl      String // URL to download the XML package
  lastFetched DateTime?
  checksum    String? // MD5 of last fetched XML, for change detection
  etag        String? // HTTP ETag from the last fetch — enables If-None-Match skips in the daily sync
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  chunks      LawChunk[]
}

model LawChunk {
  id           String                       @id @default(uuid())
  lawId        String
  law          Law                          @relation(fields: [lawId], references: [id])
  normKey      String // <enbez> value, e.g. "§ 1", "Art. 2"
  heading      String? // <titel> if present
  text         String // cleaned plain text of the norm
  embedding    Unsupported("vector(1024)")?
  embeddingBge Unsupported("vector(1024)")?
  createdAt    DateTime                     @default(now())
  roomId       String?
  room         Room?                        @relation(fields: [roomId], references: [id])
  ownerUserId  String? // set only for lawId='docvault' chunks; NULL for shared law chunks

  @@index([roomId])
  @@index([lawId, ownerUserId])
}

model Wing {
  id    String @id // "german_law" | "user_documents"
  name  String
  rooms Room[]
}

model Room {
  id       String     @id // e.g. "sozialrecht", "jobcenter"
  name     String
  wingId   String
  wing     Wing       @relation(fields: [wingId], references: [id])
  chunks   LawChunk[]
  tunnelsA Tunnel[]   @relation("RoomA")
  tunnelsB Tunnel[]   @relation("RoomB")
}

model Tunnel {
  roomAId String
  roomBId String
  roomA   Room   @relation("RoomA", fields: [roomAId], references: [id])
  roomB   Room   @relation("RoomB", fields: [roomBId], references: [id])

  @@id([roomAId, roomBId])
}

model UserDocument {
  id         String            @id @default(uuid())
  userId     String
  fileName   String?
  category   String // 'mietvertrag'|'jobcenter'|'bank'|'visa'|'versicherung'|'other'
  sourceHash String
  factsCount Int               @default(0)
  fullText   String? // sanitized extraction text (app path) — never the raw document
  summary    String? // 200-word summary generated by Haiku (or the local model on the app path)
  isActive   Boolean           @default(true) // Active/expired/closed document
  expiryDate DateTime? // Extracted expiry date if present
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  title      String? // display title (app path: generated by the local model)
  docDate    DateTime? // document date, if extracted
  status     String? // app path: "active" | "expired" | "closed"; NULL = legacy row (derive from isActive)
  appSource  Boolean           @default(false) // true = ingested via /app/v1 (macOS client)
  // sha256 of the extraction payload this row was built from. Distinguishes
  // "same document again" (no-op) from "same document, extracted differently"
  // (re-ingest). NULL = ingested before the column existed.
  extractionHash String?
  memories   UserMemory[]
  tagLinks   DocumentTagLink[]
  tasks      UserTask[]        @relation("UserTaskSourceDocument")
  insights   DocumentInsight[]

  @@unique([userId, sourceHash])
  // Keyset paging of the sync delta leg in AppSyncService.delta
  // (userId-scoped updatedAt range + order).
  @@index([userId, updatedAt])
}

model DocumentInsight {
  id         String   @id @default(uuid())
  userId     String
  documentId String
  document   UserDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceHash String // extraction this analysis was computed from; immutable input ⇒ result never goes stale
  kind       String // 'red_flag' | 'grey_zone' | 'next_step' | 'deadline_note'
  severity   String // 'high' | 'medium' | 'low'
  title      String // short headline (≤80 chars), German
  body       String // 1-2 sentences, German
  model      String // LLM that produced this insight (e.g. 'claude-sonnet-5')
  createdAt  DateTime @default(now())

  @@index([userId, documentId])
  // Keyset paging of the recent-insights leg in AppSyncService.delta
  // (userId-scoped createdAt range + order; rows are immutable).
  @@index([userId, createdAt])
  // One analysis per document: analyzeAndStore checks for existing rows
  // before paying Sonnet, so concurrent retries would both pay and write
  // duplicate rows. The composite constraint + skipDuplicates below turn
  // the loser of a concurrent race into a reader of the winner's rows.
  // Composite (not documentId-alone): a single analysis legitimately
  // produces up to 8 insights per document — a documentId-only unique
  // silently discarded all but the first row of every createMany.
  @@unique([documentId, kind, title])
}

model SyncTombstone {
  id         String   @id @default(uuid())
  userId     String
  // Synced collection the deleted row belonged to: "document" | "deadline" | "task".
  collection String
  // Id of the deleted row in its collection.
  objectId   String
  deletedAt  DateTime @default(now())

  // One tombstone per deleted row — re-deletes and double forgetAll sweeps
  // dedupe via skipDuplicates instead of piling up.
  @@unique([userId, collection, objectId])
  // Keyset paging of the tombstone leg in AppSyncService.delta.
  @@index([userId, deletedAt])
}
model UserMemory {
  id              String                       @id @default(uuid())
  userId          String
  type            String // "document" | "fact" | "preference" | "quote" | "decision"
  content         String // German text used for embedding and retrieval
  contentOriginal String? // original-language text for display; null if already German
  embedding       Unsupported("vector(1024)")?
  embeddingBge    Unsupported("vector(1024)")?
  sourceHash      String? // SHA256 of the source file; set for document/photo memories
  documentId      String? // FK to UserDocument; nullable for backward compat
  document        UserDocument?                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  wing            String? // palace wing slug — e.g. "user_chat" | "user_documents" | "german_law"
  room            String? // palace room slug — topic/category within the wing
  status          String                       @default("active") // "active" | "pending" | "stale"
  conflictGroupId String? // links members of an unresolved conflict group; null when no conflict
  createdAt       DateTime                     @default(now())

  @@index([userId, type])
  @@index([userId, wing, room])
  @@index([userId, conflictGroupId])
}

model UserDeadline {
  id           String    @id @default(uuid())
  userId       String
  label        String
  deadlineDate DateTime
  sourceType   String // "memory" | "document" | "manual"
  sourceId     String? // FK to UserMemory.id or UserDocument.id (not a hard FK — source may be deleted)
  completedAt  DateTime? // set when the user marks the deadline as done (calendar view)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt // cursor-based incremental sync to the macOS app

  @@index([userId, deadlineDate])
  @@index([userId, updatedAt])
}

model ConversationLog {
  id        String   @id @default(uuid())
  userId    String
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model BatchJobState {
  userId         String
  processedDate  DateTime // Europe/Berlin start-of-day, stored as UTC instant
  status         String // "running" | "completed" | "failed"
  factsExtracted Int       @default(0)
  factsConflicts Int       @default(0)
  errorMessage   String?
  createdAt      DateTime  @default(now())
  // When the current run claimed this row. Lets claimRun tell a dead run from
  // a live one before stealing it; NULL on rows created before the column.
  startedAt      DateTime?
  completedAt    DateTime?

  @@id([userId, processedDate])
}

model ConflictPushState {
  conflictGroupId String    @id
  userId          String
  lastPushedAt    DateTime
  pushCount       Int       @default(0)
  resolvedAt      DateTime?

  @@index([userId, resolvedAt])
}

model UserDiary {
  id           String                       @id @default(uuid())
  userId       String
  date         DateTime // start-of-day Europe/Berlin, stored as UTC instant
  entry        String // AAAK-compressed daily summary (Sonnet-generated)
  embedding    Unsupported("vector(1024)")?
  embeddingBge Unsupported("vector(1024)")?
  createdAt    DateTime                     @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

// ── macOS companion app ("Dokumente") ──────────────────────────────────────

model UserTask {
  id               String        @id @default(uuid())
  userId           String
  title            String
  description      String?
  dueDate          DateTime?
  status           String        @default("open") // "open" | "in_progress" | "done" | "missed"
  priority         String        @default("normal") // "low" | "normal" | "high"
  sourceType       String        @default("manual") // "manual" | "document" | "llm"
  sourceDocumentId String?
  sourceDocument   UserDocument? @relation("UserTaskSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  // Keyset paging of the sync delta leg in AppSyncService.delta
  // (userId-scoped updatedAt range + order).
  @@index([userId, updatedAt])
}

model DeviceSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique // sha256 hex of the raw device token — raw token is never stored
  deviceName String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  // Sessions expire (DeviceSessionTtlDays in app-auth.service.ts); expiry
  // bounds stolen-token lifetime and reaps pairing-crash orphans whose raw
  // token was never delivered. The device rotates before expiry.
  expiresAt  DateTime

  @@index([userId])
}

model DocumentTag {
  id        String            @id @default(uuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime          @default(now())
  links     DocumentTagLink[]

  @@unique([userId, name])
}

model DocumentTagLink {
  documentId String
  tagId      String
  document   UserDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        DocumentTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
}
